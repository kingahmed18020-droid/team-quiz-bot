# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC-your-token

# معرفات المشرفين (Telegram IDs) مفصولة بفواصل — اعرف رقمك من @userinfobot
ADMIN_IDS=111111111,222222222

# SQLite (تشغيل مباشر بدون Docker) — في docker-compose يُستبدل تلقائياً بـ PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///quiz.db

# كلمة مرور PostgreSQL (تُستخدم في docker-compose فقط) — غيّرها!
POSTGRES_PASSWORD=change-me

# --- ضبط المسابقة (اختياري) ---
POINTS_PER_QUESTION=10      # نقاط السؤال إن لم يحدد الملف points/difficulty
SPEED_BONUS_MAX=0.5         # أقصى بونص للسرعة (0.5 = +50% من نقاط السؤال)
BREAK_SECONDS=5             # الاستراحة بين الأسئلة (ثواني)
COUNTDOWN_INTERVAL=10       # تحديث العدّاد الحي كل كم ثانية (0 = معطّل)
COUNTDOWN_MAX_USERS=150     # يتعطل العدّاد تلقائياً فوق هذا العدد من الطلاب
